{
  "buildCommand": "echo 'Deploying verified SupplySync client production bundle'",
  "outputDirectory": "client/dist",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "client/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
